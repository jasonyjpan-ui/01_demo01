PORT=3000
HOST=localhost
API_ALLOWED_ORIGIN=
DATABASE_URL=
DATABASE_URL_MIGRATION=
STORE_DRIVER=postgres

# Google OAuth / Gmail login
# Local Google Cloud Console authorized redirect URI:
# http://localhost:3000/api/auth/google/callback
#
# Render/production Google Cloud Console authorized redirect URI:
# https://your-render-service.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URL=http://localhost:5173

# Optional on Render. If GOOGLE_REDIRECT_URI / GOOGLE_LOGIN_REDIRECT_URL are not set,
# the backend can derive them from this public URL.
PUBLIC_BASE_URL=
